{
  "name": "boilerplate-postcss",
  "version": "0.0.1",
  "author": "Dmitry Sheiko (http://dsheiko.com)",
  "keywords": [
    "sass",
    "postcss",
    "autoprefixer",
    "starter",
    "boilerplate",
    "hot"
  ],
  "scripts": {
    "build": "npm run build:sass:compile && npm run build:sass:autoprefix",
    "build:sass:compile": "sass sass/index.scss ./tmp/index.css",
    "build:sass:autoprefix": "postcss ./tmp/index.css -o ./index.css",
    "watch": "nodemon --watch sass -e scss -x \"npm run build\"",
    "start": "http-server . -o -c-1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.0",
    "http-server": "^0.10.0",
    "nodemon": "^1.12.1",
    "postcss": "^8.4.0",
    "postcss-cli": "^11.0.0"
  },
  "license": "ISC",
  "dependencies": {
    "sass": "^1.100.0"
  }
}
