{
  "name": "boilerplate-puppeteer-jest",
  "version": "0.1.0",
  "description": "E2E testing starter template with Puppeteer and Jest",
  "scripts": {
    "test": "URL=https://dsheiko.github.io/react-html5-form/ jest --",
    "test:debug": "URL=https://dsheiko.github.io/react-html5-form/ DEBUG=true jest --detectOpenHandles"
  },
  "jest": {
    "verbose": true,
    "testMatch": [
      "**/*.spec.js"
    ]
  },
  "keywords": [
    "puppeteer",
    "jest",
    "e2e",
    "testing",
    "boilerplate"
  ],
  "author": "Dmitry Sheiko (http://dsheiko.com)",
  "license": "ISC",
  "dependencies": {},
  "devDependencies": {
    "cross-env": "^5.1.6",
    "jest": "^29.7.0",
    "puppeteer": "^24.43.1",
    "express": "^4.16.3",
    "minimist": "^1.2.0"
  }
}
