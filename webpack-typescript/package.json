{
  "name": "boilerplate-webpack-typescript",
  "version": "0.0.1",
  "author": "Dmitry Sheiko (http://dsheiko.com)",
  "scripts": {
    "build": "webpack --config webpack.config.js",
    "lint": "eslint ./src --ext .ts",
    "test": "jest --verbose",
    "test:watch": "npm test -- --watch",
    "start": "http-server . -o -c-1"
  },
  "keywords": [
    "webpack",
    "typescript",
    "starter",
    "jest",
    "eslint",
    "boilerplate"
  ],
  "jest": {
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js"
    ],
    "transform": {
      "^.+\\.(ts|tsx)$": "ts-jest"
    },
    "testRegex": "/.*\\.spec\\.(ts|tsx)$"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "http-server": "^14.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.4.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.0"
  },
  "license": "ISC",
  "dependencies": {
    "console-log-html": "^2.0.2"
  }
}
